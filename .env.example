# ============================================
# DOCKER ENVIRONMENT VARIABLES
# ============================================

# Application Mode
APP_MODE=development # development | production

# Ports Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# ============================================
# DEVELOPMENT MODE (with local PostgreSQL)
# ============================================

# Database (created in Docker)
DB_DATABASE=calendar_dev
DB_USERNAME=calendar_user
DB_PASSWORD=secret

# Redis
REDIS_PASSWORD=redis_secret

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# pgAdmin
PGADMIN_EMAIL=admin@calendar.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================
# PRODUCTION MODE (external PostgreSQL)
# ============================================

# Database (external connection)
# DB_HOST=your-production-db-host.com
# DB_PORT=5432
# DB_DATABASE=calendar_production
# DB_USERNAME=calendar_prod_user
# DB_PASSWORD=your-secure-password

# Redis (if external)
# REDIS_HOST=your-redis-host.com
# REDIS_PASSWORD=your-redis-password

# Application
# APP_KEY=base64:generated-key-here
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# SSL Ports
# BACKEND_SSL_PORT=443
